{
  "name": "opensu",
  "description": "OpenSU — open-source AI modeling agent for SketchUp with bounded local automation and semantic building workflows",
  "package": "opensu-sketchup",
  "module": "sketchup_mcp.phase1_server",
  "object": "mcp",
  "tools": [
    "sketchup_status",
    "sketchup_inspect_model",
    "sketchup_create_floor",
    "sketchup_create_wall",
    "sketchup_create_opening",
    "sketchup_validate_model"
  ],
  "mcpServers": {
    "opensu": {
      "command": "uvx",
      "args": ["opensu-sketchup==1.13.0"]
    }
  }
}
